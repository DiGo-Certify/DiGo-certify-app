# Consortium infrastructure configuration. Copy to config.env and edit.
# provision-region.sh, collect-nodes.sh and besu/gen-config.sh source this file.

# --- OpenStack instance parameters (per region; the openrc selects the region) ---
IMAGE="Ubuntu-Noble-Latest"      # Ubuntu 24.04 LTS; SSH user 'ubuntu'
FLAVOR="t1.medium"               # 2 vCPU / 4 GB; use t1.large for headroom
KEYPAIR="KEYNAME"                 # must exist in EACH region (keypairs are region-local)
NET="n-PROJECT"                 # tenant network (local IPs)
SECGROUP="besu-consortium"

# How many validators to boot in the currently-sourced region.
# Cross-region 2+2: run provision-region.sh once per region with START_INDEX 1 then 3.
# Single-region 4:  set NODES_PER_REGION=4 and run once (START_INDEX=1).
NODES_PER_REGION="${NODES_PER_REGION:-2}"

# --- Security-group source ranges (RESTRICT THESE) ---
ADMIN_CIDR="0.0.0.0/0"           # <-- your VPN address/CIDR for SSH; do not leave open
HARNESS_CIDR="0.0.0.0/0"         # <-- your VPN address/CIDR for JSON-RPC (8545)
# P2P between validators: the two tenant /27s (adjust if you change regions/subnets)
P2P_CIDRS="100.68.0.128/27 100.64.10.192/27"

# --- Besu / chain parameters ---
CHAIN_ID="1337"
BLOCK_PERIOD="2"                 # QBFT block interval (s); sweep 1/2/5 for the throughput curve
GAS_LIMIT="0x1C9C380"            # 30,000,000; matches the paper's analytical block-gas bound
BESU_IMAGE="hyperledger/besu:24.9.1"   # must support Shanghai (PUSH0); bump if needed

# --- Prefunded accounts (harness signers) ---
# Hardhat's default test mnemonic; its first PREFUND_COUNT addresses are prefunded
# in genesis so ethers.getSigners() returns funded accounts on the consortium net.
MNEMONIC="test test test test test test test test test test test junk"
PREFUND_COUNT="20"

# --- SSH (for Ansible inventory) ---
SSH_USER="ubuntu"
SSH_KEY="$HOME/.ssh/KEYNAME.pem"  # private key matching the 'KEYNAME' keypair
