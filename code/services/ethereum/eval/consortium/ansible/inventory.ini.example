# Generated by provision/collect-nodes.sh; this is an illustrative example.
# node_index maps each host to its validator key (besu/out/node<idx>/key) and is
# used as the advertised P2P host via ansible_host.
[besu]
besu-1 ansible_host=100.68.0.140  node_index=1
besu-2 ansible_host=100.68.0.141  node_index=2
besu-3 ansible_host=100.64.10.200 node_index=3
besu-4 ansible_host=100.64.10.201 node_index=4

[besu:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/KEYNAME.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
